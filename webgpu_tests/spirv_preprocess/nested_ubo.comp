#version 450
layout(local_size_x = 1) in;
struct Inner { vec4 color; mat2 transform; };
struct Outer { Inner values[2]; vec4 weights[3]; };
layout(set = 0, binding = 0, std140) uniform InputBlock { Outer value; } input_block;
layout(set = 0, binding = 1, std430) buffer OutputBlock { vec4 value; } output_block;

Outer forward_value(Outer value) { return value; }

void main() {
    Outer local_value = forward_value(input_block.value);
    output_block.value = local_value.values[1].color * local_value.weights[2]
        + vec4(local_value.values[0].transform[1], 0.0, 1.0);
}
