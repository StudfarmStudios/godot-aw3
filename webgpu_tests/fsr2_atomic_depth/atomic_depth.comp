#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require

// These are the production WebGPU FSR2 callback switches. The included header
// owns the indexing, bounds checks and min/max atomics being tested.
#define FFX_GPU 1
#define FFX_GLSL 1
#define FFX_HALF 0
#define NO_IMAGE_ATOMICS
#define FSR2_BIND_CB_FSR2 0
#if TEST_OPERATION == 4
#define FSR2_BIND_SRV_RECONSTRUCTED_PREV_NEAREST_DEPTH 1
#else
#define FSR2_BIND_UAV_RECONSTRUCTED_PREV_NEAREST_DEPTH 2
#endif
#include "ffx_fsr2_callbacks_glsl.h"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(push_constant, std430) uniform Params { uint phase; uint seed; uint reset_bits; uint pad; } params;
#if TEST_OPERATION == 4
layout(set = 1, binding = 3, std430) writeonly buffer Results { uint result_values[]; };
#endif

ivec2 invalid_coordinate(uint index) {
    // Several invalid 2D positions have valid flattened buffer indices. WebGPU
    // buffer robustness alone cannot catch them; callback bounds checks must.
    switch (index) {
        case 0u: return ivec2(-1, 1);
        case 1u: return ivec2(MaxRenderSize().x, 0);
        case 2u: return ivec2(MaxRenderSize().x + 1, 0);
        case 3u: return ivec2(-MaxRenderSize().x, 2);
        case 4u: return ivec2(0, MaxRenderSize().y);
        case 5u: return ivec2(MaxRenderSize().x - 1, MaxRenderSize().y);
        case 6u: return ivec2(0, -1);
        default: return ivec2(MaxRenderSize().x + 1, -1);
    }
}

void main() {
    uint invocation = gl_GlobalInvocationID.x;
    uint count = uint(MaxRenderSize().x * MaxRenderSize().y);
#if TEST_OPERATION == 0
    if (invocation < count) {
        SetReconstructedDepth(ivec2(int(invocation) % MaxRenderSize().x, int(invocation) / MaxRenderSize().x), params.reset_bits);
    }
#elif TEST_OPERATION == 1
    if (invocation < count * 4096u) {
        uint pixel = invocation % count;
        uint writer = invocation / count;
        // Odd multiplier permutes all 4,096 candidate levels for each texel.
        // Alternating to a narrower range requires reset to discard old extrema.
        uint level = (writer * 37u + pixel * 13u + params.seed * 97u) & 4095u;
        float value = params.phase == 0u ? 0.125 + float(level) / 8192.0 : 0.25 + float(level) / 16384.0;
        StoreReconstructedDepth(ivec2(int(pixel) % MaxRenderSize().x, int(pixel) / MaxRenderSize().x), value);
    }
#elif TEST_OPERATION == 2
    if (invocation < 8u) {
        SetReconstructedDepth(invalid_coordinate(invocation), floatBitsToUint(0.875));
    }
#elif TEST_OPERATION == 3
    if (invocation < 8u) {
        StoreReconstructedDepth(invalid_coordinate(invocation), FFX_FSR2_OPTION_INVERTED_DEPTH != 0 ? 1.0 : 0.0);
    }
#elif TEST_OPERATION == 4
    if (invocation < count) {
        result_values[invocation] = floatBitsToUint(LoadReconstructedPrevDepth(ivec2(int(invocation) % MaxRenderSize().x, int(invocation) / MaxRenderSize().x)));
    } else if (invocation < count + 8u) {
        result_values[invocation] = floatBitsToUint(LoadReconstructedPrevDepth(invalid_coordinate(invocation - count)));
    }
#endif
}
