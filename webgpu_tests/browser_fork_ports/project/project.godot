config_version=5

[application]
config/name="WebGPU candidate browser regressions"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=512
window/size/viewport_height=384
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.web="forward_plus"
rendering_device/driver.web="webgpu"
camera/depth_of_field/depth_of_field_use_jitter=false
textures/default_filters/use_nearest_mipmap_filter=false

[gui]
theme/lcd_subpixel_layout=1
