#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

if env["vulkan"]:
    env.add_source_files(env.editor_sources, "shader_baker_export_plugin_platform_vulkan.cpp")

if env["d3d12"]:
    env.add_source_files(env.editor_sources, "shader_baker_export_plugin_platform_d3d12.cpp")

if env["metal"] or env.metal_shader_baker_only:
    env.add_source_files(env.editor_sources, "shader_baker_export_plugin_platform_metal.cpp")

if env.metal_shader_baker_only:
    # The Metal shader container, without the driver, goes into the editor
    # library: only the baker uses it, and GNU ld resolves a library's references
    # only against libraries after it, which the drivers library is not.
    SConscript("#drivers/metal/SCsub")

if env["webgpu"] and env["platform"] != "web":
    env.add_source_files(env.editor_sources, "shader_baker_export_plugin_platform_webgpu.cpp")
